# Public URL of the backend API (no trailing slash, without /api).
#   Local dev:   http://localhost:4000
#   Production:  https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# OPTIONAL — same-origin proxy mode (recommended for production on Vercel).
# When set, the frontend forwards /api/* to this backend and NEXT_PUBLIC_API_URL
# should be left EMPTY. The backend's COOKIE_SAMESITE can then be "lax".
# API_PROXY_TARGET=https://your-api.onrender.com
