# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (M0 free cluster works fine).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/librarp?retryWrites=true&w=majority
MONGODB_URI=

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional (defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# ─── CORS / cookies ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Dev:  http://localhost:3000
# Prod: https://your-project.vercel.app
FRONTEND_URL=http://localhost:3000

# SameSite policy for the refresh-token cookie.
#   lax  → frontend and API share a site (localhost dev, or Vercel rewrite proxy)
#   none → frontend and API are on different sites (e.g. vercel.app → onrender.com)
# Defaults to "lax" in development and "none" in production.
COOKIE_SAMESITE=

# Number of reverse-proxy hops in front of the API, so rate limiting and audit
# logs see the real client IP. Render alone = 1 (default in production);
# Vercel rewrite proxy (API_PROXY_TARGET) + Render = 2.
TRUST_PROXY=

# ─── Bootstrap: first Executive Director (used ONLY by `npm run seed:executive`) ──
# Leave empty to be prompted interactively. Remove from the environment after use.
BOOTSTRAP_EXEC_USERNAME=
BOOTSTRAP_EXEC_DISPLAY_NAME=
BOOTSTRAP_EXEC_PASSWORD=
